# Normalize line endings to LF in the repo for all text files.
# Working-tree files on Windows still appear with CRLF if the user has
# core.autocrlf=true, but the canonical version stored in git is LF.
* text=auto eol=lf

# Binary files: never touch them.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.pdf    binary
*.apk    binary
*.aab    binary
*.keystore binary
*.jks    binary

# Shell scripts must stay LF even on Windows checkouts (Git Bash needs it).
*.sh     text eol=lf
gradlew  text eol=lf

# Windows-only files stay CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
